{% assign r = include.repository %}
<div class="repo p-2">
  <a class="repo-card" href="https://github.com/{{ r.repo }}">
    <div class="repo-name"><i class="fa-brands fa-github"></i> {{ r.repo | split: '/' | last }}</div>
    {% if r.fork_of %}<div class="repo-fork">forked from {{ r.fork_of }}</div>{% endif %}
    <p class="repo-desc">{{ r.description }}</p>
    {% if r.language %}<div class="repo-lang"><span class="repo-lang-dot"></span>{{ r.language }}</div>{% endif %}
  </a>
</div>
